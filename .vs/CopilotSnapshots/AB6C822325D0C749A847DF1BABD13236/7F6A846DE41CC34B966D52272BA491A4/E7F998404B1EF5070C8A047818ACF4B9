using TaskService;

namespace TaskClientApp
{
    public partial class Form1 : Form
    {
        private List<RentalAgreement> rentalAgreements = new();

        public Form1()
        {
            InitializeComponent();
            LoadRentalData();
        }

        private void button1_Click(object sender, EventArgs e)
        {
            try
            {
                // Validate inputs
                if (string.IsNullOrWhiteSpace(txtCarModel.Text) ||
                    string.IsNullOrWhiteSpace(txtRenterName.Text) ||
                    string.IsNullOrWhiteSpace(txtDailyRate.Text))
                {
                    lblStatus.Text = "❌ אנא מלא את כל השדות!";
                    lblStatus.ForeColor = Color.Red;
                    return;
                }

                if (!decimal.TryParse(txtDailyRate.Text, out decimal dailyRate) || dailyRate <= 0)
                {
                    lblStatus.Text = "❌ עלות ליום חייבת להיות מספר חיובי!";
                    lblStatus.ForeColor = Color.Red;
                    return;
                }

                // Create rental agreement
                var agreement = new RentalAgreement
                {
                    CarModel = txtCarModel.Text,
                    RenterName = txtRenterName.Text,
                    RentalDays = (int)numRentalDays.Value,
                    DailyRate = dailyRate,
                    TotalCost = dailyRate * numRentalDays.Value,
                    RentalDate = DateTime.Now
                };

                rentalAgreements.Add(agreement);

                // Service integration
                var service = new TaskService.Services.Service1();
                service.CreateTask(
                    $"הסכם: {agreement.CarModel}",
                    $"שוכר: {agreement.RenterName}, ימים: {agreement.RentalDays}, סה\"ק: ₪{agreement.TotalCost}"
                );

                // Refresh display
                UpdateDisplay();
                ClearInputFields();
                lblStatus.Text = $"✅ הסכם הוסף בהצלחה! סה\"ק: ₪{agreement.TotalCost:N2}";
                lblStatus.ForeColor = Color.Green;
            }
            catch (Exception ex)
            {
                lblStatus.Text = $"❌ שגיאה: {ex.Message}";
                lblStatus.ForeColor = Color.Red;
            }
        }

        private void btnClearForm_Click(object sender, EventArgs e)
        {
            ClearInputFields();
            lblStatus.Text = "✅ הטופס נוקה";
            lblStatus.ForeColor = Color.Green;
        }

        private void ClearInputFields()
        {
            txtCarModel.Clear();
            txtRenterName.Clear();
            txtDailyRate.Clear();
            numRentalDays.Value = 3;
        }

        private void LoadRentalData()
        {
            try
            {
                var service = new TaskService.Services.Service1();
                var allTasks = service.GetAllTasks();
                dataGridView1.DataSource = allTasks;
            }
            catch (Exception ex)
            {
                lblStatus.Text = $"❌ לא הצלח לטעון נתונים: {ex.Message}";
                lblStatus.ForeColor = Color.Red;
            }
        }

        private void UpdateDisplay()
        {
            try
            {
                var service = new TaskService.Services.Service1();
                var allTasks = service.GetAllTasks();
                dataGridView1.DataSource = null;
                dataGridView1.DataSource = allTasks;

                // Update list view
                lstRentals.Items.Clear();
                foreach (var agreement in rentalAgreements)
                {
                    lstRentals.Items.Add(
                        $"{agreement.CarModel} - {agreement.RenterName} ({agreement.RentalDays} ימים) - ₪{agreement.TotalCost:N2}"
                    );
                }
            }
            catch (Exception ex)
            {
                lblStatus.Text = $"❌ שגיאה בעדכון: {ex.Message}";
                lblStatus.ForeColor = Color.Red;
            }
        }
    }

    public class RentalAgreement
    {
        public string CarModel { get; set; }
        public string RenterName { get; set; }
        public int RentalDays { get; set; }
        public decimal DailyRate { get; set; }
        public decimal TotalCost { get; set; }
        public DateTime RentalDate { get; set; }
    }
}
