# ---------------------------------------------------------------------------
# Phoenix RAG Bot — environment variables (template)
# Copy this file to ".env" and fill in your real values.
# The real .env is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# Google Gemini API keys. The system tries them IN ORDER: on quota/rate-limit
# (429) or auth error it automatically falls over to the next. Add one key per
# Google account. Get keys at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Path to the tenant configuration file (optional; default: config/phoenix.yaml).
# PHOENIX_TENANT_CONFIG=config/phoenix.yaml

# Allowed CORS origins — comma-separated, or "*" for any (public demo).
# PHOENIX_CORS_ORIGINS=*
