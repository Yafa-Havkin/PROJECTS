<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<system.serviceModel>
		<services>
			<service name="UnitManagerService.Services.UnitManagerService">
				<endpoint address="" binding="basicHttpBinding" contract="UnitManagerService.Interfaces.IUnitManager" />
				<host>
					<baseAddresses>
						<add baseAddress="http://localhost:8734/UnitService/" />
					</baseAddresses>
				</host>
			</service>
		</services>
	</system.serviceModel>
</configuration>