<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<system.serviceModel>
		<services>
			<service name="ThreatAnalysisService.Services.ThreatAnalysisService">
				<endpoint address="" binding="basicHttpBinding" contract="ThreatAnalysisService.Interfaces.IThreatAnalysis" />
				<host>
					<baseAddresses>
						<add baseAddress="http://localhost:8733/ThreatService/" />
					</baseAddresses>
				</host>
			</service>
		</services>
	</system.serviceModel>
</configuration>